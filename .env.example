# Local Company V2 environment example.
# Copy this file to .env and edit values for your machine.

# Local app server.
PORT=8788

# Keep this relative path for a normal local install.
# Use data-sample after running `npm run seed:demo` if you want the demo workspace.
DATA_DIR=./data

# AI runner mode.
# Keep mock for offline demos. Use codex-cli to call a locally authenticated Codex CLI.
CODEX_RUNNER=mock
CODEX_CLI_BIN=codex
CODEX_PM_MODEL=gpt-5.5
CODEX_WORKER_MODEL=gpt-5.3-codex
CODEX_SCRIBE_MODEL=gpt-5.3-codex
CODEX_TIMEOUT_MS=600000
# Optional extra flags passed to `codex exec`, for example: --sandbox read-only
CODEX_EXEC_ARGS=

# Never put real secrets in .env.example.
# Put private values only in your local .env, which is ignored by git.
# OPENAI_API_KEY=
