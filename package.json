{
  "name": "local-company-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "mcp:local-company": "tsx src/mcp/local-company-mcp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx scripts/seed-demo.ts --data-dir data-sample",
    "check:public": "tsx scripts/check-public-ready.ts",
    "review:phase0": "tsx scripts/review-phase0.ts",
    "review:phase1": "tsx scripts/review-phase1.ts",
    "review:phase2": "tsx scripts/review-phase2.ts",
    "review:phase3": "tsx scripts/review-phase3.ts",
    "review:phase4": "tsx scripts/review-phase4.ts",
    "review:phase5": "tsx scripts/review-phase5.ts",
    "review:phase6": "tsx scripts/review-phase6.ts",
    "review:phase7": "tsx scripts/review-phase7.ts",
    "review:phase8": "tsx scripts/review-phase8.ts",
    "review:phase9": "tsx scripts/review-phase9.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "marked": "^18.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
